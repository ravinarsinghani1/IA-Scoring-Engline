# Copy this file to client/.env and fill in the values. client/.env is gitignored.
# These are the PUBLIC Supabase values (safe to ship to the browser) — never put
# the service_role key or JWT secret here.
#
# From your Supabase DEV project dashboard -> Project Settings -> API:
#   VITE_SUPABASE_URL       = Project URL, e.g. https://<ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY  = the public "anon" key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Question Bank backend (deployed separately from the main API — see
# server/fly.toml / server/render deploy notes). Generation can run for
# minutes over SSE, which the main Vercel-hosted API cannot hold open, so this
# one route group is served from a long-running host instead.
#   Local dev:  http://localhost:4000  (same server, run `npm run dev` in server/)
#   Production: the deployed host's URL, e.g. https://ia-scoring-engine.onrender.com
VITE_QUESTION_BANK_API_URL=http://localhost:4000
