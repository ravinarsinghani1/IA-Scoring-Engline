# Copy this file to server/.env and fill in the values. server/.env is gitignored.

# Your Anthropic API key (get one at https://console.anthropic.com/).
# Stays server-side only — never sent to the frontend.
ANTHROPIC_API_KEY=

# Supabase Postgres connection string.
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543) — the pooled
# string is what works on serverless (Vercel). It contains your DB password, so
# keep this file secret. Example shape:
#   postgresql://postgres.<ref>:<password>@aws-...-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Storage — holds uploaded PDFs (local disk doesn't persist on Vercel).
# From Supabase dashboard -> Project Settings -> API:
#   SUPABASE_URL              = the Project URL (https://<ref>.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = the service_role secret (SERVER-SIDE ONLY — never
#                               expose to the frontend). Pasted-text drafts work
#                               without these; only PDF uploads need them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional bucket name (auto-created as private). Defaults to "drafts".
# SUPABASE_STORAGE_BUCKET=drafts

# Optional: model used for scoring. Defaults to claude-sonnet-5 (strong + cost-safe
# for a pilot). Set to claude-opus-4-8 for maximum quality at higher cost.
# SCORING_MODEL=claude-sonnet-5

# Optional: backend port (defaults to 4000).
# PORT=4000
