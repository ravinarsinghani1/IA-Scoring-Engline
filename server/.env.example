# Copy this file to server/.env and fill in your key. server/.env is gitignored.

# Your Anthropic API key (get one at https://console.anthropic.com/).
# Stays server-side only — never sent to the frontend.
ANTHROPIC_API_KEY=

# Optional: model used for scoring. Defaults to claude-opus-4-8 (most capable).
# Set to claude-sonnet-5 to reduce cost during a pilot.
# SCORING_MODEL=claude-opus-4-8

# Optional: backend port (defaults to 4000).
# PORT=4000
